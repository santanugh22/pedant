{
  "expo": {
    "name": "Feedants",
    "slug": "feedants-competition",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "feedants",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E6E71"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feedants.competition"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E6E71"
      },
      "package": "com.feedants.competition"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video"
    ]
  }
}
