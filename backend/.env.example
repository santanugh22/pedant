# Server
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

# Database
# If left empty or replica set fails, an automatic local MongoMemoryReplSet is started for turnkey evaluation
MONGODB_URI=mongodb://127.0.0.1:27017/feedants?replicaSet=rs0

# Redis (falls back to in-memory mock if Redis is unreachable)
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_ACCESS_SECRET=feedants_jwt_access_secret_key_2026_dev
JWT_REFRESH_SECRET=feedants_jwt_refresh_secret_key_2026_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# Razorpay (Test mode)
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=rzp_test_secret_key_feedants
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_feedants

# File Upload Switch: 'local' (default for zero-setup evaluation) or 's3' (production AWS S3)
UPLOAD_PROVIDER=local
AWS_ACCESS_KEY_ID=test_aws_key
AWS_SECRET_ACCESS_KEY=test_aws_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=feedants-submissions

# Business Rules
REGISTRATION_HOLD_TTL_MINUTES=15
REFERRAL_REWARD_AMOUNT=10

# CORS
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
